  "verified_static_conclusions": [
    "Focus weapon IDs E8-EB cannot index any of the three 96-entry vanilla weapon auxiliary tables in place.",
    "The palette-index overrun aliases occupied weapon-hit SFX entries 28-2B.",
    "The swing- and hit-SFX overruns alias reachable enemy Attack-animation packages.",
    "Palette rows are six-byte bank-D1 payloads, and both menu callers hard-code bank D1 for their copies.",
    "Named expanded palette, swing-SFX, and hit-SFX descriptors require explicit adapters before any Focus weapon can bind them."
  ],
  "limitations": [
    "This audit does not execute logical PC 07, Focus Pulse, or a Focus weapon.",
    "The enemy Attack-animation selector reference counts are bounded static ownership facts, not a complete semantic decode of the attack packages.",
    "This audit does not assign native palette or SFX IDs and does not bind any source-only Focus descriptor.",
    "This audit does not approve hooks, expanded allocations, ROM mutation, patches, or production installation."
  ]
