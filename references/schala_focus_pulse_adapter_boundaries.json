  "verified_static_conclusions": [
    "Raw Focus Pulse action ID 90 cannot index the vanilla 124-record character-action table.",
    "Focus weapon IDs E8-EB cannot index the vanilla 95-record equipped-weapon Attack-config table.",
    "The three logical-PC-07 Attack branches cannot receive three new contiguous normal-Attack selectors in place.",
    "The action record, weapon Attack config, selector resolver, and any new downstream assets require named expanded descriptors and adapters."
  ],
  "limitations": [
    "This audit does not execute logical PC 07 or Focus Pulse.",
    "Selector IDs 13 and 14 are inside the canonical resolver extent but are not declared free by this audit.",
