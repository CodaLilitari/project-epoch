    {
      "node_id": "quest_locked_line",
      "type": "dialogue",
      "speaker": "Gaspar",
      "text": "A sealed hour is brushing against this place, but the path has not taken shape. We should listen before we force it open.",
      "dialogue_source": "written-for-project-epoch",
      "next": "end_not_ready",
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
    {
      "node_id": "anchors_incomplete_line",
      "type": "dialogue",
      "speaker": "Gaspar",
      "text": "The pocket answers, but its pattern is incomplete. Set all three anchors before we risk the crossing.",
      "dialogue_source": "written-for-project-epoch",
      "next": "end_not_ready",
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
    {
      "node_id": "ward_unresolved_line",
      "type": "dialogue",
      "speaker": "Schala",
      "text": "The refuge still leans upon my ward. Break the guardian's hold, and I can open a road for everyone sheltered here.",
      "dialogue_source": "written-for-project-epoch",
      "next": "end_not_ready",
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
    {
      "node_id": "magus_observation",
      "type": "dialogue",
      "speaker": "Magus",
      "text": "That ward bears your hand. It endured by feeding upon the instant around it.",
      "dialogue_source": "written-for-project-epoch",
      "next": "schala_answers_magus",
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
    {
      "node_id": "schala_answers_magus",
      "type": "dialogue",
      "speaker": "Schala",
      "text": "You still hear the shape of my magic. Then hear this as well: what follows will be my decision.",
      "dialogue_source": "written-for-project-epoch",
      "next": "recruitment_offer",
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
    {
      "node_id": "schala_without_magus",
      "type": "dialogue",
      "speaker": "Schala",
      "text": "The ward has spent its last reserve. I can release those sheltered here, but I cannot close the breach alone.",
      "dialogue_source": "written-for-project-epoch",
      "next": "recruitment_offer",
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
    {
      "node_id": "recruitment_offer",
      "type": "dialogue",
      "speaker": "Schala",
      "text": "The survivors have a road beyond this fragment. I have chosen mine. If you will have me, I will stand with you against the darkness my kingdom fed.",
      "dialogue_source": "written-for-project-epoch",
      "next": "recruitment_choice",
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
    {
      "node_id": "recruitment_choice",
      "type": "choice",
      "prompt": "Invite Schala to join?",
      "options": [
        {
          "choice_id": "accept",
          "label": "Stand with us.",
          "next": "commit_recruitment"
        },
        {
          "choice_id": "decline",
          "label": "Not yet.",
          "next": "decline_line"
        }
      ],
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
    {
      "node_id": "decline_line",
      "type": "dialogue",
      "speaker": "Schala",
      "text": "Then I will keep the crossing quiet until you return. Choice loses its meaning when it is hurried.",
      "dialogue_source": "written-for-project-epoch",
      "next": "end_declined",
      "mapping_status": "unmapped",
      "runtime_binding": null
    },
